# Required. Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# Dashboard. Leave these empty to run the bot without it.
# Discord Developer Portal > your application > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# The address you open in your browser. Add <this address>/auth/callback as an OAuth2 redirect.
DASHBOARD_URL=http://localhost:3000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Where tickets and settings are stored.
DATABASE_PATH=./data/toxtickety.db

# Optional. Registers slash commands instantly on one server while you test.
DEV_GUILD_ID=

# Text shown as the bot's "Watching ..." status.
BOT_STATUS=your tickets
